# ---------------------------------------------------------------------------
# GridCast environment configuration
# Copy this file to .env and adjust values as needed.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=gridcast
POSTGRES_PASSWORD=gridcast
POSTGRES_DB=gridcast
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the backend.
# When running via docker-compose, POSTGRES_HOST=postgres.
# When running the backend locally against dockerized postgres, use localhost.
DATABASE_URL=postgresql+psycopg2://gridcast:gridcast@localhost:5432/gridcast

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data providers ---
# "synthetic" (default, always works) or "real"
ELECTRICITY_PROVIDER=synthetic
# Open-Meteo requires no API key for non-commercial use.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Optional: real electricity load API (e.g. EIA). Leave blank to force synthetic mode.
EIA_API_KEY=
EIA_API_BASE_URL=https://api.eia.gov/v2

# --- Demo region defaults ---
DEMO_REGION_SLUG=demo-region
DEMO_REGION_NAME=Demo Metro Area
DEMO_REGION_COUNTRY=US
DEMO_REGION_TIMEZONE=America/New_York
DEMO_REGION_LATITUDE=40.7128
DEMO_REGION_LONGITUDE=-74.0060

# --- ML ---
MODEL_ARTIFACT_DIR=/app/data/models
RANDOM_SEED=42

# --- Drift detection ---
DRIFT_MAPE_DEGRADATION_THRESHOLD_PCT=15.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
