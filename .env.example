# ---------------------------------------------------------------------------
# GridCast environment configuration
# Copy this file to .env and adjust values as needed.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=gridcast
POSTGRES_PASSWORD=gridcast
POSTGRES_DB=gridcast
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the backend.
# When running via docker-compose, POSTGRES_HOST=postgres.
# When running the backend locally against dockerized postgres, use localhost.
DATABASE_URL=postgresql+psycopg2://gridcast:gridcast@localhost:5432/gridcast

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data providers ---
# "synthetic" (DEMO mode, default, always works, no key needed) or "real"
# (LIVE mode - requires EIA_API_KEY below). This single flag is also what
# derives data_mode ("live"/"demo") shown in /health and the Admin Console -
# there is deliberately no separate mode flag that could disagree with it.
ELECTRICITY_PROVIDER=synthetic
# Open-Meteo requires no API key for non-commercial use. Used for weather in
# BOTH modes (real weather improves even demo load's temperature response).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Real electricity load API - U.S. Energy Information Administration (EIA).
# See README "Data Sources" for why EIA (a U.S. source) was selected over an
# Indian one. Get a free key at https://www.eia.gov/opendata/register.php
# (the shared "DEMO_KEY" also works for light/rate-limited testing but is
# not meant for sustained production use - register your own key).
# Leave blank to force DEMO mode regardless of ELECTRICITY_PROVIDER.
EIA_API_KEY=
EIA_API_BASE_URL=https://api.eia.gov/v2
# Balancing-authority code to treat as the live region. NYIS = New York ISO
# (verified: hourly actual demand, UTC-labeled timestamps, history to 2019).
EIA_RESPONDENT_CODE=NYIS

# --- Demo region defaults ---
DEMO_REGION_SLUG=demo-region
DEMO_REGION_NAME=Demo Metro Area
DEMO_REGION_COUNTRY=US
DEMO_REGION_TIMEZONE=America/New_York
DEMO_REGION_LATITUDE=40.7128
DEMO_REGION_LONGITUDE=-74.0060

# --- Live region metadata (distinct from the demo region above so live and
# demo data can never mix in one region row) ---
LIVE_REGION_NAME=nyiso-live
LIVE_REGION_COUNTRY=US
LIVE_REGION_TIMEZONE=America/New_York
LIVE_REGION_LATITUDE=40.7128
LIVE_REGION_LONGITUDE=-74.0060

# --- Historical backfill (app.tasks.backfill_live / make backfill-live) ---
# ISO date/datetime, UTC. Leave both blank to default to a 90-day trailing
# window ending now at run time (never a hardcoded date, which would go
# stale) - see README "Live Mode".
GRIDCAST_BACKFILL_START=
GRIDCAST_BACKFILL_END=

# --- ML ---
MODEL_ARTIFACT_DIR=/app/data/models
RANDOM_SEED=42

# --- Drift detection ---
DRIFT_MAPE_DEGRADATION_THRESHOLD_PCT=15.0

# --- Auth / sessions ---
# "development" or "production" - purely informational, surfaced in /health
# and the Admin Console.
ENVIRONMENT=development

# REQUIRED - the backend will not start without this set. A long random
# secret used to sign session tokens. Generate one with
# `openssl rand -hex 32` (or equivalent) and never commit the real value.
# Anyone with this secret can forge admin sessions.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

SESSION_COOKIE_NAME=gridcast_session
# Must be "true" for any deployment served over HTTPS - browsers silently
# drop Secure cookies over plain HTTP, so keep this false for local dev only.
COOKIE_SECURE=false
# "lax" works when frontend+backend share a domain (even on different ports,
# as in local dev). A production split across different domains needs
# "none" (which additionally requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# --- First-admin bootstrap ---
# Leave BOTH blank to skip bootstrap (no admin created, login/admin console
# stay inaccessible until you set these and restart, or run
# `python -m app.tasks.bootstrap_admin` / `make create-admin`).
# Idempotent: safe to leave set across restarts - it will never overwrite an
# existing account or create duplicates.
GRIDCAST_ADMIN_USERNAME=
GRIDCAST_ADMIN_PASSWORD=

# --- Login rate limiting (in-memory, single-process - see README) ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
